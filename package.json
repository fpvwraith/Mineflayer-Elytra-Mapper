{
  "name": "argus-elytra-mapper",
  "version": "2.0.0",
  "description": "Autonomous elytra terrain mapper for 6b6t-style anarchy servers. Flies a bot over the world and saves Xaero World Map compatible region files locally. Use it as a CLI or a Node library.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./writer": "./lib/xaero-writer/index.js",
    "./planner": "./lib/planner.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "argus-mapper": "bin/argus-mapper.js"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/argus-mapper.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "mineflayer": "^4.38.0",
    "mineflayer-elytrafly": "^1.4.8",
    "pngjs": "^7.0.0",
    "prismarine-block": "^1.21.0",
    "vec3": "^0.1.10"
  },
  "optionalDependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "prismarine-chunk": "^1.36.0",
    "prismarine-registry": "^1.11.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpvwraith/Mineflayer-Elytra-Mapper.git"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "6b6t",
    "anarchy",
    "map",
    "elytra",
    "bot",
    "xaero",
    "argus"
  ]
}
